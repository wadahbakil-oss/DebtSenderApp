<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مرسل الديون"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اختر العميل"
        android:textSize="16sp"/>

    <Spinner
        android:id="@+id/customerSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/currentDebtText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الرصيد الحالي: 0 ريال"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/debtAmountInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="المبلغ الجديد المقيد"
        android:inputType="numberDecimal"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/sendWhatsAppBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="إرسال عبر واتساب"
        android:textSize="18sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/sendSmsBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="إرسال عبر رسالة نصية"
        android:textSize="18sp"/>

</LinearLayout>
